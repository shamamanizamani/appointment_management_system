# Postgres. postgres:// and postgresql:// URLs (Render/Railway) are converted to asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/queue
# Used by pytest only. Must contain "test" in the name; tests wipe it.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/queue_test

# JWT. Use a long random string in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
